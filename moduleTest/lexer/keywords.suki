// 词法分析器测试 - 关键字
// Lexer test - keywords

module TestLexer;

let x = 10
var y = 20
func add(a: Int, b: Int) -> Int {
    return a + b
}
struct Point { var x: Double }
class Animal { var name: String }
enum Color {
    case red
    case green
    case blue
}
protocol Drawable { func draw() }
actor Counter { var value = 0 }
extension Int { var doubled: Int { return self * 2 } }
typealias Text = String
