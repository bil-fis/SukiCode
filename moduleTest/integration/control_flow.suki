// 集成测试 - 控制流编译运行
// Integration test - control flow compile and run

func absolute(n: Int) -> Int {
    if n < 0 {
        return 0 - n
    }
    return n
}

func sum(n: Int) -> Int {
    var total = 0
    var i = 0
    while i <= n {
        total += i
        i += 1
    }
    return total
}

@main
func main() -> Int {
    let a = absolute(n: -42)
    let b = sum(n: 10)
    print(a)
    print(b)
    return 0
}
