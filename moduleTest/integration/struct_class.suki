// Integration test - structs and classes

struct Point {
    var x: Double
    var y: Double
}

class Animal {
    var name: String
    init(name: String) {
        self.name = name
    }
    func speak() -> String {
        return "..."
    }
}

class Dog: Animal {
    override func speak() -> String {
        return "Woof!"
    }
}

@main
func main() -> Int {
    let p = Point(x: 1.0, y: 2.0)
    let dog = Dog(name: "Buddy")
    print(42)
    return 0
}
