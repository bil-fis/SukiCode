// Integration test - enums and pattern matching

enum Direction {
    case north
    case south
    case east
    case west
}

func describe(d: Direction) -> String {
    switch d {
    case .north: return "N"
    case .south: return "S"
    case .east: return "E"
    case .west: return "W"
    }
}

@main
func main() -> Int {
    let dir = Direction.north
    print(42)
    return 0
}
