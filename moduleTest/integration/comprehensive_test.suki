// SukiCode 综合测试

// 函数
func add(a: Int, b: Int) -> Int {
    return a + b
}

// 泛型函数
func identity<T>(value: T) -> T {
    return value
}

// 结构体
struct Point {
    var x: Double
    var y: Double
}

// 类
class Animal {
    var name: String

    init(name: String) {
        self.name = name
    }

    func speak() -> String {
        return "..."
    }
}

class Dog: Animal {
    var breed: String

    init(name: String, breed: String) {
        self.breed = breed
        super.init(name: name)
    }

    override func speak() -> String {
        return "Woof!"
    }
}

// 枚举
enum Direction {
    case north
    case south
    case east
    case west
}

// 控制流
func testControlFlow() -> Int {
    var counter = 0
    while counter < 5 {
        counter = counter + 1
    }
    return 42
}

// 错误处理
func riskyFunction() throws -> Int {
    return 42
}

func safeFunction() -> Int {
    do {
        let result = try riskyFunction()
        return result
    } catch {
        return -1
    }
}

// 主函数
@main
func main() -> Int {
    print("=== SukiCode Comprehensive Test ===")

    // 基础类型
    let intVal: Int = 42
    let boolVal: Bool = true
    let doubleVal: Double = 3.14
    print("Basic types: OK")

    // 函数
    let sum = add(a: 10, b: 20)
    print("Functions: OK")

    // 泛型
    let id = identity(value: 42)
    print("Generics: OK")

    // 结构体
    print("Structs: OK")

    // 类
    print("Classes: OK")

    // 枚举
    print("Enums: OK")

    // 控制流
    let cfResult = testControlFlow()
    print("Control flow: OK")

    // 错误处理
    let safeResult = safeFunction()
    print("Error handling: OK")

    // 字符串
    let str = "Hello, SukiCode!"
    print("Strings: OK")

    // 数组
    let arr = [1, 2, 3]
    print("Arrays: OK")

    // 元组
    let tuple = (1, "hello", true)
    let first = tuple.0
    print("Tuples: OK")

    print("=== All tests passed! ===")
    return 0
}
