// Parser test - expressions
// All expressions the current parser supports

func add(a: Int, b: Int) -> Int { return a + b }
func risky() throws -> String { return "ok" }
func fetch() async -> String { return "data" }

func expressions() {
    // Arithmetic
    let a = 1 + 2 * 3 - 4 / 2

    // Comparison and logic
    let b = a > 10 && a < 100

    // Bitwise
    let c = 0xFF & 0x0F | 0xF0

    // Range
    let r1 = 0..<10
    let r2 = 1...5

    // Array literal
    let arr = [1, 2, 3, 4, 5]

    // Dictionary literal
    let dict = ["key": "value", "name": "test"]

    // Tuple
    let tuple = (1, "hello", true)

    // Closure
    let closure = { (x: Int) -> Int in return x * 2 }
    let arrow = (x: Int) => x * 2

    // Function call
    let result = add(a: 1, b: 2)

    // Member access
    let len = "hello".count

    // Subscript
    let first = arr[0]

    // as/is
    let casted = 42 as Double
    let checked = 42 is Int

    // try/await
    let data = try risky()
    let asyncData = await fetch()

    // move
    let owned = move data

    // if expression
    let val = if a > 0 { 1 } else { 0 }

    // String interpolation
    let msg = "value: \(a), result: \(result)"

    // Null coalescing
    var opt: String? = "hello"
    let fallback = opt ?? "default"

    // Force unwrap
    let unwrapped = opt!
}

// TODO: set literal {1, 2, 3} causes segfault in some contexts
