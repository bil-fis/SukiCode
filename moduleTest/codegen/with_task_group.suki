// `withTaskGroup`（规范 7.3）：作用域内派发的子任务在作用域退出前全部完成。
// Spec 7.3: withTaskGroup — children never outlive the group scope.
//
// 期望行为：组内 3 个子任务各自增一次，await 后结果为 3，退出码 0。

var total: Int = 0

@main
func main() -> Int {
    let f = withTaskGroup { g in
        var i = 0
        while i < 3 {
            g.addTask {
                atomicAdd(&total, 1)
            }
            i = i + 1
        }
    }
    await f
    if total == 3 {
        return 0
    }
    return 1
}
