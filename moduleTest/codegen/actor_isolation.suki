// actor 隔离（规范 7.4）：跨 actor 的调用是异步的，且同一 actor 的方法串行执行，
// 因此其可变状态不会出现数据竞争。
// Spec 7.4: actor isolation — calls into an actor are async and serialised, so its
// mutable state is race-free.
//
// 期望行为：两个异步任务各对同一 actor 自增 1000 次，结果恰为 2000，退出码 0。
// 若隔离失效（并发读写未串行化），会出现丢失更新而结果偏小。

actor Counter {
    var value: Int = 0
    func increment() { value = value + 1 }
    func getValue() -> Int { return value }
}

async func bump(c: Counter) -> Int {
    var i = 0
    while i < 1000 {
        let f = c.increment()
        await f
        i = i + 1
    }
    return 0
}

@main
func main() -> Int {
    let c = Counter()
    let a = bump(c)
    let b = bump(c)
    await a
    await b
    let g = c.getValue()
    let v = await g
    if v == 2000 {
        return 0
    }
    return 1
}
