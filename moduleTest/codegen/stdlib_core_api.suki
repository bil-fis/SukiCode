// Core 标准库高阶集合 API / 数值 / 字符串 / Result 类型 验证。
// 全部断言通过返回 0，否则返回累计失败权重。

import core

enum DivError: Error {
    case zero
}

func divide(_ a: Int, _ b: Int) -> Result<Int, DivError> {
    if b == 0 { return Result<Int, DivError>.failure(DivError.zero) }
    return Result<Int, DivError>.success(a / b)
}

@main func main() -> Int {
    var score = 0

    // 1. mapInt / filterInt / reduceInt
    let xs = [1, 2, 3, 4]
    let doubled = mapInt(xs, { x in x * 2 })
    if doubled[0] == 2 && doubled[3] == 8 { score += 1 }
    let evens = filterInt(xs, { x in (x % 2) == 0 })
    if evens.count == 2 { score += 2 }
    let total = reduceInt(xs, 0, { acc, x in acc + x })
    if total == 10 { score += 4 }

    // 2. sortedInt
    let mixed = [3, 1, 4, 1, 5, 9, 2, 6]
    let sortedV = sortedInt(mixed)
    if sortedV[0] == 1 && sortedV[7] == 9 { score += 8 }
    if sumInt(xs) == 10 { score += 16 }

    // 3. contains / firstIndex / all
    if containsIntWhere(xs, { x in x == 3 }) { score += 32 }
    if firstIndexIntWhere(xs, { x in x == 4 }) == 3 { score += 64 }
    if allInt(xs, { x in x > 0 }) { score += 128 }

    // 4. 字符串：split / joined / stringContains
    let parts = split("a,b,c", ",")
    if parts.count == 3 && parts[1] == "b" { score += 256 }
    let joinedV = joined(["x", "y", "z"], "-")
    if joinedV == "x-y-z" { score += 512 }
    if stringContains("hello world", "world") { score += 1024 }

    // 5. 数值工具
    if gcd(12, 18) == 6 { score += 2048 }
    if lcm(4, 6) == 12 { score += 4096 }
    if powInt(2, 10) == 1024 { score += 8192 }
    if sign(-5) == -1 && sign(0) == 0 && sign(7) == 1 { score += 16384 }

    // 6. Result 类型（直接 switch 解构，编译器支持）
    let ok = divide(10, 2)
    let v = unwrapViaSwitch(ok)
    if v == 5 { score += 32768 }
    let bad = divide(5, 0)
    if isFailViaSwitch(bad) { score += 65536 }

    let expected = 1 + 2 + 4 + 8 + 16 + 32 + 64 + 128 + 256 + 512 +
                   1024 + 2048 + 4096 + 8192 + 16384 + 32768 + 65536
    if score == expected { return 0 }
    return score
}

func unwrapViaSwitch(_ r: Result<Int, DivError>) -> Int {
    switch r {
    case Result<Int, DivError>.success(let v): return v
    case Result<Int, DivError>.failure(let e): return 0
    }
}

func isFailViaSwitch(_ r: Result<Int, DivError>) -> Bool {
    switch r {
    case Result<Int, DivError>.success(let v): return false
    case Result<Int, DivError>.failure(let e): return true
    }
}
