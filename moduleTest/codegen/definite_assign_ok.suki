// 规范 §1.3 延迟初始化：`let` 可不立即赋值，但必须在所有控制流路径上恰好
// 赋值一次。本用例覆盖合法的延迟初始化形态（if/else 全覆盖、switch 带
// default 全覆盖、顺序赋值），退出码 0 表示通过。

func pick(c: Bool) -> Int {
    let v: Int
    if (c) { v = 1 } else { v = 2 }
    return v
}

func bySwitch(n: Int) -> Int {
    let v: Int
    switch n { case 0: v = 10 default: v = 20 }
    return v
}

func sequential() -> Int {
    let v: Int
    v = 42
    return v
}

@main
func main() -> Int {
    if (pick(c: true) != 1) { return 1 }
    if (pick(c: false) != 2) { return 1 }
    if (bySwitch(n: 0) != 10) { return 1 }
    if (bySwitch(n: 7) != 20) { return 1 }
    if (sequential() != 42) { return 1 }
    return 0
}
