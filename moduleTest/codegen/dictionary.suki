// 字典与集合：哈希表插入/查询/删除/覆盖，Set 去重语义
// Dictionary and Set: insert, lookup, remove, overwrite; Set de-duplication

func dictBasics() -> Int {
    let d: [Int: Int] = [:]
    d.set(1, 10)
    d.set(2, 20)
    d.set(3, 30)
    if d.count != 3 { return 1 }
    if !d.containsKey(2) { return 2 }
    if d.get(9) != nil { return 3 }        // 缺失键
    d.set(1, 99)                           // 覆盖不增加计数
    if d.count != 3 { return 4 }
    d.removeValue(3)
    if d.count != 2 { return 5 }
    if d.isEmpty { return 6 }
    return 0
}

func dictLiteral() -> Int {
    let lit: [Int: Int] = [7: 70, 8: 80]
    if lit.count != 2 { return 1 }
    return 0
}

func setBasics() -> Int {
    let s: Set<Int> = []
    s.insert(1)
    s.insert(2)
    s.insert(2)                             // 重复插入不改变集合
    if s.count != 2 { return 1 }
    if !s.contains(1) { return 2 }
    if s.contains(9) { return 3 }
    s.remove(1)
    if s.count != 1 { return 4 }
    if s.isEmpty { return 5 }
    return 0
}

@main
func main() -> Int {
    let a = dictBasics()
    if a != 0 { return a }
    let b = dictLiteral()
    if b != 0 { return 10 + b }
    let c = setBasics()
    if c != 0 { return 20 + c }
    return 0
}
