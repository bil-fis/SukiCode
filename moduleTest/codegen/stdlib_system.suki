// System 模块类型化 API 回归测试（非限定访问，规避模块限定访问缺陷）
import core
import system

@main func main() -> Int {
    var score = 0

    // Path
    let p = Path("/a/b/c.txt")
    if p.lastComponent() == "c.txt" { score += 1 }
    if p.directory() == "/a/b/" { score += 2 }
    if p.ext() == "txt" { score += 4 }
    let q = p.appending("d")
    if q.path == "/a/b/c.txt/d" { score += 8 }
    if !p.exists() { score += 16 }   // /a/b/c.txt 不应存在

    // FileManager：写后读回
    let tmp = Path("/tmp/suki_typed_api_test.txt")
    let fm = FileManager.shared()
    if fm.write(tmp, "hello typed api") {
        if fm.exists(tmp) { score += 32 }
        if fm.read(tmp) == "hello typed api" { score += 64 }
    }

    // Date
    let d = Date.now()
    if d.seconds > 0 { score += 128 }

    // OS 环境
    let os = OS()
    if os.hasEnvironment("PATH") { score += 256 }
    if os.environment("SUKI_CODE_NO_SUCH_VAR_XYZ") == "" { score += 512 }

    // Hardware
    let hw = Hardware()
    if hw.cpuCount() > 0 { score += 1024 }
    if hw.totalMemory() > 0 { score += 2048 }

    // Process
    let proc = Process()
    if proc.run("true") == 0 { score += 4096 }
    if stringContains(proc.capture("echo hello"), "hello") { score += 8192 }

    let expected = 1 + 2 + 4 + 8 + 16 + 32 + 64 + 128 + 256 + 512
                   + 1024 + 2048 + 4096 + 8192
    if score == expected { return 0 }
    return score
}
