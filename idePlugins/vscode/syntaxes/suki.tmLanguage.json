{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SukiCode",
  "scopeName": "source.suki",
  "fileTypes": [
    "suki"
  ],
  "patterns": [
    {
      "include": "#comment.doc"
    },
    {
      "include": "#comment.line"
    },
    {
      "include": "#comment.block"
    },
    {
      "include": "#string"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#type-decl"
    },
    {
      "include": "#func-decl"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment.doc": {
      "name": "comment.line.documentation.suki",
      "begin": "///",
      "end": "$"
    },
    "comment.line": {
      "name": "comment.line.double-slash.suki",
      "begin": "//",
      "end": "$"
    },
    "comment.block": {
      "name": "comment.block.suki",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string": {
      "patterns": [
        {
          "include": "#string-multiline"
        },
        {
          "include": "#string-double"
        },
        {
          "include": "#char"
        }
      ]
    },
    "string-multiline": {
      "name": "string.quoted.triple.suki",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#string-escape"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.suki",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#string-escape"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.suki",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "string-escape": {
      "name": "constant.character.escape.suki",
      "match": "\\\\(n|t|r|\\\\|\"|'|0|[xX][0-9a-fA-F]{2})"
    },
    "interpolation": {
      "name": "meta.embedded.expression.suki",
      "begin": "\\\\\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.suki",
      "match": "#\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.suki"
        }
      }
    },
    "attribute": {
      "name": "entity.other.attribute.suki",
      "match": "@([A-Za-z_][A-Za-z0-9_]*)"
    },
    "type-decl": {
      "match": "\\b(struct|enum|class|protocol|actor|extension|typealias|associatedtype)\\s+([A-Za-z_\\u4e00-\\u9fff][A-Za-z0-9_\\u4e00-\\u9fff]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.suki"
        },
        "2": {
          "name": "entity.name.type.suki"
        }
      }
    },
    "func-decl": {
      "match": "\\b(func|subscript)\\s+([A-Za-z_\\u4e00-\\u9fff][A-Za-z0-9_\\u4e00-\\u9fff]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.suki"
        },
        "2": {
          "name": "entity.name.function.suki"
        }
      }
    },
    "keyword": {
      "name": "keyword.suki",
      "match": "\\b(module|import|let|var|func|struct|enum|class|protocol|extension|typealias|associatedtype|init|deinit|subscript|if|else|guard|switch|case|default|for|in|while|repeat|loop|break|continue|fallthrough|return|where|as|is|nil|true|false|self|Self|super|throw|throws|rethrows|try|catch|do|public|private|internal|fileprivate|static|final|override|required|convenience|lazy|inout|mutating|nonmutating|get|set|willSet|didSet|weak|unowned|unsafe|move|async|await|actor|select|some|macro|foreign|extern|defer)\\b"
    },
    "builtin-type": {
      "name": "support.type.suki",
      "match": "\\b(Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Int|Float|Double|Bool|String|Character|Void|Any|Error|Optional|Array|Dictionary|Set|Result|Range|Never)\\b"
    },
    "function-call": {
      "match": "([A-Za-z_\\u4e00-\\u9fff][A-Za-z0-9_\\u4e00-\\u9fff]*)\\s*(\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.suki"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.suki"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.suki",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.suki",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.suki",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\d+[eE][+-]?\\d+\\b|\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.suki",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.suki",
      "match": "->|=>|<-|\\.\\.\\.|\\.\\.<|\\.\\.|==|!=|<=|>=|<<|>>|\\?\\?|&&|\\|\\|[-+*/%=<>!&|^~?]"
    },
    "punctuation": {
      "name": "punctuation.suki",
      "match": "[\\(\\)\\[\\]\\{\\}\\.,;:]"
    }
  }
}
