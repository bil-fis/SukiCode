// Concurrency — async/await, actor, TaskGroup, Channel, select (specification §7).
// Demonstrates the full concurrency family implemented in the `concurrency`
// standard-library module. Runs to completion and exits 0; every subsystem is
// exercised through a real call path.

import concurrency

// ── Actor: serialised mutable state ──────────────────────────────────────────
actor Counter {
    private var value: Int = 0
    func increment() { value = value + 1 }
    func getValue() -> Int { return value }
}

// ── async function ───────────────────────────────────────────────────────────
async func compute(_ n: Int) -> Int {
    return n * 2
}

// ── Channel: producer / consumer with for-await ──────────────────────────────
async func producerConsumer() {
    let channel = Channel<Int>(capacity: 10)
    Task {
        var i = 0
        while i < 100 {
            await channel.send(i)
            i = i + 1
        }
        await channel.close()
    }
    var sum = 0
    for await value in channel {
        sum = sum + value
    }
    print("channel sum = \(sum)")
}

// ── select: receive from whichever channel is ready ──────────────────────────
async func selectDemo() {
    let ch1 = Channel<String>(capacity: 1)
    await ch1.send("hello")
    select {
    case msg <- ch1:
        print("select got: \(msg)")
    default:
        print("select default")
    }
}

// ── TaskGroup: fan-out fan-in ────────────────────────────────────────────────
async func taskGroupDemo() {
    await withTaskGroup { group in
        var i = 0
        while i < 4 {
            // 每次迭代绑定独立的 `n`，供闭包按引用捕获正确的值
            // （与全局可变状态共享一致，遵循本语言的引用捕获语义）。
            let n = i
            group.addTask { return await compute(n) }
            i = i + 1
        }
        var total = 0
        for await data in group {
            total = total + data
        }
        print("taskgroup total = \(total)")
    }
}

@main func main() async -> Int {
    // 1. Actor: increment three times (serialised, no data race).
    let counter = Counter()
    counter.increment()
    counter.increment()
    counter.increment()

    // 2. Channel producer/consumer (for-await drains until closed).
    await producerConsumer()

    // 3. select: receive the value we just sent.
    await selectDemo()

    // 4. TaskGroup fan-out/fan-in.
    await taskGroupDemo()

    print("concurrency demo done")
    return 0
}
